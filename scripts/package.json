    "complexity:check": "node complexity.mjs",
    "complexity:update": "node complexity.mjs --update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "beautiful-mermaid": "1.1.3",
    "esbuild": "0.28.2",
    "prismjs": "1.30.0"
  }
}
